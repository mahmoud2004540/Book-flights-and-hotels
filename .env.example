# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.
# Variables needed at the current stage are marked [now]; the rest are filled
# in when their stage arrives.
# ---------------------------------------------------------------------------

# --- Database and cache ---
# [now] PostgreSQL connection string. On Neon, copy the *pooled* connection.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# [stage 2] Redis on Upstash — cache, rate limiting and job queues.
REDIS_URL=

# --- Authentication [now] ---
# next-auth v5 reads AUTH_SECRET. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Kept in step with AUTH_SECRET for tooling that still looks for the old name.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# [now] Key for encrypting passport numbers (AES-256-GCM).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Suppliers [stage 2] ---
# Register free at developers.amadeus.com and use the test environment.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Duffel — the supplier that lets us issue the ticket ourselves, with no IATA
# licence. Get a token at app.duffel.com; one starting duffel_test returns
# fabricated airlines and fares and must never be used in production.
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
BOOKINGCOM_API_KEY=
# The mock adapter, for tests only. The app refuses to boot if this is true in production.
SUPPLIER_MOCK_ENABLED=false

# --- Payments [now] ---
# From the Stripe dashboard. Test keys (sk_test_…) are fine for development.
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint you create. Without it webhooks are refused,
# which is deliberate: an unverified endpoint lets anyone mark a booking as paid.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
TAP_SECRET_KEY=
# The mock payment provider, for tests only. No card is taken and no money
# moves. The app refuses to boot if this is true in production.
PAYMENT_MOCK_ENABLED=false
PAYMENT_MOCK_WEBHOOK_SECRET=mock-secret

# --- Email, storage and maps ---
# [now] Without a key, development prints emails to the server console and
# production refuses to send — an unsent verification email is a broken sign-up.
RESEND_API_KEY=
EMAIL_FROM="Rehlaty <no-reply@example.com>"
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Scheduled jobs [now] ---
# Shared secret for the reminder cron route. Without it the route refuses every
# call, which is deliberate: an open endpoint that sends email is a spam relay.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Monitoring and app ---
# [stage 8]
SENTRY_DSN=
# [now]
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [now] Default markup percentage. Any rule in markup_rules overrides it.
DEFAULT_MARKUP_PERCENT=4.5
