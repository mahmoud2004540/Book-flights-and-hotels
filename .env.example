# ---------------------------------------------------------------------------
# انسخ هذا الملف إلى .env واملأ القيم. ممنوع رفع .env إلى المستودع.
# المتغيّرات المطلوبة في المرحلة الحالية معلَّمة بـ [الآن]؛ الباقي يُملأ في مرحلته.
# ---------------------------------------------------------------------------

# --- قاعدة البيانات والكاش ---
# [الآن] رابط PostgreSQL. على Neon انسخ رابط الاتصال المجمّع (pooled).
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# [المرحلة 2] Redis على Upstash — للكاش وحدود الطلبات وطوابير المهام.
REDIS_URL=

# --- المصادقة [المرحلة 1] ---
# ولّده بـ: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# مفتاح تشفير أرقام الجوازات (AES-256-GCM). ولّده بـ: openssl rand -hex 32
ENCRYPTION_KEY=

# --- المزوّدون [المرحلة 2] ---
# سجّل مجانًا على developers.amadeus.com واستخدم بيئة test.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
DUFFEL_ACCESS_TOKEN=
BOOKINGCOM_API_KEY=
# المحوّل الوهمي للاختبارات فقط. التطبيق يرفض الإقلاع لو كان true في الإنتاج.
SUPPLIER_MOCK_ENABLED=false

# --- الدفع [المرحلة 5] ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
TAP_SECRET_KEY=

# --- الإيميل والتخزين والخرائط [المراحل 3 و 5] ---
RESEND_API_KEY=
EMAIL_FROM="Rehlaty <no-reply@example.com>"
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- المراقبة والتطبيق ---
# [المرحلة 8]
SENTRY_DSN=
# [الآن]
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [الآن] نسبة الهامش الافتراضية. تغلبها أي قاعدة في جدول markup_rules.
DEFAULT_MARKUP_PERCENT=4.5
