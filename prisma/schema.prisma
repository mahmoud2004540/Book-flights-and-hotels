// Database schema — section 6 of the brief.
// All money is Decimal(12,2): computing money in floating point produces
// sub-cent drift that accumulates.
// Every field ending in Enc is AES-256-GCM encrypted before write (section 8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------- Enums

enum Role {
  USER
  SUPPORT
  FINANCE
  SUPER_ADMIN
}

enum ServiceType {
  FLIGHT
  HOTEL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum AmountType {
  PERCENT
  FIXED
}

enum NotifChannel {
  EMAIL
  IN_APP
  WHATSAPP
  SMS
}

enum Locale {
  AR
  EN
}

enum Currency {
  EGP
  USD
  SAR
  AED
  EUR
}

// ------------------------------------------------------- Users and profiles

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String? // null for OAuth-only accounts
  name            String?
  phone           String?
  role            Role      @default(USER)
  locale          Locale    @default(AR)
  currency        Currency  @default(EGP)
  emailVerifiedAt DateTime?
  twoFactorSecret String? // encrypted — 2FA is optional
  isBlocked       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile       Profile?
  travelers     SavedTraveler[]
  bookings      Booking[]
  searches      Search[]
  favorites     Favorite[]
  notifications Notification[]
  accounts      Account[]
  sessions      Session[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  userId         String    @id
  dob            DateTime?
  nationality    String? // ISO 3166-1 alpha-2
  passportNoEnc  String?
  passportExpiry DateTime?
  preferences    Json      @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model SavedTraveler {
  id            String        @id @default(cuid())
  userId        String
  firstName     String
  lastName      String
  dob           DateTime
  nationality   String?
  passportNoEnc String?
  type          PassengerType
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_travelers")
}

// -------------------------------------------------------- Auth (NextAuth)

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuthAttempt {
  // Keyed by email or IP. Kept in the database rather than memory because
  // serverless instances do not share memory — an in-memory counter would
  // reset on every cold start and let an attacker through.
  identifier  String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  lastFailAt  DateTime  @default(now())

  @@index([lockedUntil])
  @@map("auth_attempts")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime // one hour — section 4.4
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// ------------------------------------------------------ Search and offer cache

model Search {
  id           String      @id @default(cuid())
  userId       String? // null for guests
  type         ServiceType
  params       Json
  resultsCount Int         @default(0)
  durationMs   Int?
  createdAt    DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("searches")
}

model OffersCache {
  cacheKey   String   @id
  supplierId String
  payload    Json
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
  @@map("offers_cache")
}

// ---------------------------------------------------------------- Bookings

model Booking {
  id          String        @id @default(cuid())
  reference   String        @unique // the reference shown to the user
  userId      String? // null for guest bookings
  guestEmail  String?
  type        ServiceType
  supplierId  String
  supplierRef String?
  pnr         String?
  status      BookingStatus @default(PENDING)

  netAmount      Decimal  @db.Decimal(12, 2)
  markupAmount   Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(12, 2)
  currency       Currency

  idempotencyKey String    @unique // guards against double booking
  promoCodeId    String?
  expiresAt      DateTime? // session deadline for pending bookings
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  promoCode  PromoCode?    @relation(fields: [promoCodeId], references: [id])
  items      BookingItem[]
  passengers Passenger[]
  payments   Payment[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("bookings")
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  itemType  String // flight_segment · hotel_room · baggage · seat · insurance
  details   Json
  amount    Decimal @default(0) @db.Decimal(12, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_items")
}

model Passenger {
  id             String        @id @default(cuid())
  bookingId      String
  firstName      String
  lastName       String
  dob            DateTime
  nationality    String?
  passportNoEnc  String?
  passportExpiry DateTime?
  type           PassengerType

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("passengers")
}

// ------------------------------------------------------ Payments and refunds

model Payment {
  id          String        @id @default(cuid())
  bookingId   String
  provider    String // stripe · paymob · tap
  providerRef String        @unique
  amount      Decimal       @db.Decimal(12, 2)
  currency    Currency
  status      PaymentStatus @default(PROCESSING)
  rawResponse Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id          String       @id @default(cuid())
  paymentId   String
  amount      Decimal      @db.Decimal(12, 2)
  reason      String
  status      RefundStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime     @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// ------------------------------------- Suppliers, markup and discount codes

model Supplier {
  id       String  @id // amadeus · travelpayouts · duffel · bookingcom
  name     String
  isActive Boolean @default(false)
  priority Int     @default(100) // lower value wins
  config   Json    @default("{}") // settings only — never secrets

  bookings    Booking[]
  markupRules MarkupRule[]
  logs        SupplierLog[]

  @@map("suppliers")
}

model MarkupRule {
  id          String       @id @default(cuid())
  supplierId  String? // null = all suppliers
  serviceType ServiceType? // null = both service types
  destination String? // IATA code or country — null = everywhere
  type        AmountType
  value       Decimal      @db.Decimal(10, 2)
  priority    Int          @default(100) // the most specific rule wins
  isActive    Boolean      @default(true)

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([isActive, priority])
  @@map("markup_rules")
}

model PromoCode {
  id           String     @id @default(cuid())
  code         String     @unique
  discountType AmountType
  value        Decimal    @db.Decimal(10, 2)
  maxUses      Int?
  usedCount    Int        @default(0)
  minAmount    Decimal?   @db.Decimal(12, 2)
  validFrom    DateTime
  validTo      DateTime
  isActive     Boolean    @default(true)

  bookings Booking[]

  @@index([code, isActive])
  @@map("promo_codes")
}

// ------------------------------------------ Favourites, notifications, logs

model Favorite {
  id        String      @id @default(cuid())
  userId    String
  type      ServiceType
  payload   Json // snapshot of the saved offer
  lastPrice Decimal?    @db.Decimal(12, 2) // for the price-change alert
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("favorites")
}

model Notification {
  id        String       @id @default(cuid())
  userId    String
  type      String
  channel   NotifChannel
  payload   Json
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model SupplierLog {
  id         String   @id @default(cuid())
  supplierId String
  endpoint   String
  durationMs Int
  statusCode Int?
  error      String?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, createdAt])
  @@map("supplier_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
